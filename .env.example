# Current app flows (catalog + tax guide) do not require this key.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional release signing variables (used only for release signing config).
# KEYSTORE_PATH=/absolute/path/to/your-upload-key.jks
# STORE_PASSWORD=your_store_password
# KEY_PASSWORD=your_key_password
